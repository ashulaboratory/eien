# Eien 環境変数テンプレート
# このファイルを .env としてコピーし、適切な値を設定してください
# .env はgitignoreされるので、機密情報を入れても安全です
#
# cp .env.example .env

# ==============================================
# データベース
# ==============================================
# PostgreSQL接続URL
EIEN_DB_URL=postgres://eien:eien_dev_password@localhost:5432/eien?sslmode=disable

# ==============================================
# サーバ
# ==============================================
# バックエンドサーバが listen するポート
PORT=8080
